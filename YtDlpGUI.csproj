<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <StartupObject>YtDlpGUI.Program</StartupObject>
    <PackageIcon>banner.png</PackageIcon>
    <ApplicationIcon>appicon.ico</ApplicationIcon>
    <!-- Version is 1.0.<build>, where build = days since 2000-01-01 (shown in the About dialog). -->
    <BuildNumber>$([System.DateTime]::Today.Subtract($([System.DateTime]::Parse('2000-01-01'))).Days)</BuildNumber>
    <VersionPrefix>1.0.$(BuildNumber)</VersionPrefix>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!-- Release builds/publish produce one standalone, self-contained exe (no .dll or .NET runtime needed). -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="appicon.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Update="banner.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Update="Resources.Designer.tt">
      <Generator>TextTemplatingFileGenerator</Generator>
      <DependentUpon>Resources.resx</DependentUpon>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </None>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.Designer.tt</DependentUpon>
    </Compile>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources.resx">
      <Generator></Generator>
    </EmbeddedResource>
  </ItemGroup>

  <!-- A plain Release build (dotnet build -c Release, or Build in Visual Studio) also publishes two single-file exes:
         publish\                     self-contained (includes the .NET runtime, ~50 MB)
         publish-framework-dependent\ needs the .NET 10 Desktop Runtime installed (much smaller)
         release\                     both, renamed YtDlpGUI-self-contained.exe / YtDlpGUI-framework-dependent.exe
       Skipped when publishing explicitly, to avoid running Publish twice. -->
  <Target Name="PublishAfterBuild" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' and '$(_IsPublishing)' != 'true' and '$(FrameworkDependentPass)' != 'true'">
    <CallTarget Targets="Publish" />
    <!-- Separate project instance (different global properties) with its own obj/out dirs so nothing is shared with the self-contained pass. -->
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="Publish"
             Properties="FrameworkDependentPass=true;SelfContained=false;EnableCompressionInSingleFile=false;IntermediateOutputPath=$(BaseIntermediateOutputPath)$(Configuration)\fdd\;OutDir=$(BaseOutputPath)$(Configuration)\fdd\;PublishDir=$(BaseOutputPath)$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\publish-framework-dependent\" />
    <!-- Collect both exes under distinct names in one folder, ready to upload as release assets. -->
    <PropertyGroup>
      <ReleaseDir>$(BaseOutputPath)$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\release\</ReleaseDir>
      <PublishRoot>$(BaseOutputPath)$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\</PublishRoot>
    </PropertyGroup>
    <MakeDir Directories="$(ReleaseDir)" />
    <Copy SourceFiles="$(PublishRoot)publish\$(AssemblyName).exe" DestinationFiles="$(ReleaseDir)$(AssemblyName)-self-contained.exe" />
    <Copy SourceFiles="$(PublishRoot)publish-framework-dependent\$(AssemblyName).exe" DestinationFiles="$(ReleaseDir)$(AssemblyName)-framework-dependent.exe" />
    <Message Importance="high" Text="Release files: $(ReleaseDir)" />
  </Target>

  <!-- App.config only holds legacy defaults that AppSettings can import; it is not needed next to the published exe. -->
  <Target Name="RemoveConfigFromPublish" AfterTargets="Publish">
    <Delete Files="$(PublishDir)$(TargetFileName).config" />
  </Target>

  <ItemGroup>
    <Service Include="{508349b6-6b84-4df5-91f0-309beebad82d}" />
  </ItemGroup>

</Project>